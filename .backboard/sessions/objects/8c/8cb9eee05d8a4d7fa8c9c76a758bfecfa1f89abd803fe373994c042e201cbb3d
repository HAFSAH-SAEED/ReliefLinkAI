"""Streamlit entry point for the ReliefLink AI application.

This file stays intentionally small so the app can grow without mixing page
configuration, UI rendering, service clients, and future business logic.
"""

from config import PAGE_CONFIG
from ui import render_homepage


def main() -> None:
    """Render the current Streamlit homepage."""
    render_homepage(PAGE_CONFIG)


if __name__ == "__main__":
    main()
