"""Backboard API client setup for ReliefLink AI.

This module is the single place where the app creates a Backboard SDK client.
Keeping API setup here protects the rest of the codebase from SDK details and
makes future assistant, thread, chat, and memory features easier to test.
"""

from __future__ import annotations

import json
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Optional

from backboard import BackboardClient, BackboardError


BACKBOARD_API_KEY_ENV = "BACKBOARD_API_KEY"
ASSISTANT_NAME = "ReliefLink"
ASSISTANT_STORE_PATH = Path("reliefLink.json")
ASSISTANT_SYSTEM_PROMPT = """
You are ReliefLink, a professional humanitarian disaster-relief reporting assistant.
Your role is to help people affected by disasters clearly explain what happened,
where they are, what immediate risks exist, and what support may be needed.

Respond with calm, practical, accessible language. Prioritize safety, urgency,
medical needs, shelter, water, food, evacuation concerns, and vulnerable people.
Do not claim to contact emergency services or relief organizations directly.
When a situation appears life-threatening, advise the user to contact local
emergency services immediately if they can do so safely.
""".strip()


class BackboardConfigurationError(RuntimeError):
    """Raised when required Backboard configuration is missing or invalid."""


class AssistantStoreError(RuntimeError):
    """Raised when the local assistant_id store cannot be read safely."""


class AssistantCreationError(RuntimeError):
    """Raised when the Backboard assistant cannot be created or retrieved."""


class ThreadCreationError(RuntimeError):
    """Raised when a Backboard conversation thread cannot be created."""


class MessageSendError(RuntimeError):
    """Raised when a message cannot be sent through a Backboard thread."""


@dataclass(frozen=True)
class BackboardSettings:
    """Configuration required to initialize the official Backboard SDK client."""

    api_key: str


@dataclass(frozen=True)
class AssistantLoadResult:
    """Result returned when the ReliefLink assistant is loaded or created."""

    assistant_id: str
    was_created: bool


@dataclass(frozen=True)
class ConversationThread:
    """In-memory thread context for one app launch or test run.

    Thread IDs are intentionally not saved to disk. A thread represents one
    active conversation, while the assistant is the persistent identity reused
    across launches.
    """

    thread_id: str
    assistant_id: str


def load_backboard_settings() -> BackboardSettings:
    """Load Backboard settings from environment variables only.

    The API key is intentionally read only from BACKBOARD_API_KEY so secrets are
    never hard-coded, checked into source control, or stored in Streamlit state.
    """
    api_key = os.getenv(BACKBOARD_API_KEY_ENV, "").strip()

    if not api_key:
        raise BackboardConfigurationError(
            f"Missing Backboard API key. Set the {BACKBOARD_API_KEY_ENV} environment variable."
        )

    return BackboardSettings(api_key=api_key)


def create_backboard_client() -> BackboardClient:
    """Create an authenticated official Backboard SDK client.

    This function does not create assistants, threads, memory, or chat messages.
    Those behaviors will be added in later phases on top of this service layer.
    """
    settings = load_backboard_settings()
    return BackboardClient(api_key=settings.api_key)


def create_thread(
    assistant: Optional[AssistantLoadResult] = None,
    client: Optional[BackboardClient] = None,
) -> ConversationThread:
    """Create one fresh Backboard thread for the loaded ReliefLink assistant.

    The assistant is loaded from reliefLink.json through create_or_load_assistant.
    The returned thread context is kept only in memory by the caller; this keeps
    each app launch isolated while still reusing the same assistant profile.
    """
    backboard_client = client or create_backboard_client()
    assistant_result = assistant or create_or_load_assistant(backboard_client)

    try:
        thread = backboard_client.create_thread(assistant_result.assistant_id)
    except BackboardError as exc:
        raise ThreadCreationError("Failed to create a Backboard thread for ReliefLink.") from exc

    return ConversationThread(
        thread_id=str(thread.thread_id),
        assistant_id=assistant_result.assistant_id,
    )


def send_message(
    thread: ConversationThread,
    message: str,
    client: Optional[BackboardClient] = None,
) -> str:
    """Send a user message and return only the assistant reply text.

    The function signature stays stable for callers while this service controls
    Backboard-specific behavior internally. Every message uses memory="Auto" so
    Backboard can decide what important facts should persist across threads for
    the same assistant.
    """
    if not message.strip():
        raise MessageSendError("Cannot send an empty message to Backboard.")

    backboard_client = client or create_backboard_client()

    try:
        response = backboard_client.send_message(
            message.strip(),
            thread_id=thread.thread_id,
            assistant_id=thread.assistant_id,
            memory="Auto",
        )
    except BackboardError as exc:
        raise MessageSendError("Failed to send the message through Backboard.") from exc

    reply_text = _extract_assistant_reply(response)
    if not reply_text:
        raise MessageSendError("Backboard returned an empty assistant reply.")

    return reply_text


def create_or_load_assistant(client: Optional[BackboardClient] = None) -> AssistantLoadResult:
    """Create the ReliefLink assistant once, then reuse it on later runs.

    The local reliefLink.json file is the source of truth for assistant reuse.
    If the file is missing, this is treated as the first run and a new assistant
    is created. If the file exists but is corrupted, the function fails instead
    of creating another assistant because creating a duplicate would violate the
    one-assistant requirement.
    """
    backboard_client = client or create_backboard_client()

    stored_assistant_id = _load_stored_assistant_id()
    if stored_assistant_id:
        _verify_assistant_exists(backboard_client, stored_assistant_id)
        return AssistantLoadResult(assistant_id=stored_assistant_id, was_created=False)

    return _create_and_store_assistant(backboard_client)


def _load_stored_assistant_id() -> Optional[str]:
    """Read the saved assistant id, or return None for a true first run."""
    if not ASSISTANT_STORE_PATH.exists():
        return None

    try:
        data: dict[str, Any] = json.loads(ASSISTANT_STORE_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise AssistantStoreError(
            f"{ASSISTANT_STORE_PATH} is corrupted and could not be parsed as JSON. "
            "Fix or remove the file before trying again."
        ) from exc

    assistant_id = data.get("assistant_id")
    if not isinstance(assistant_id, str) or not assistant_id.strip():
        raise AssistantStoreError(
            f"{ASSISTANT_STORE_PATH} must contain a non-empty 'assistant_id' string."
        )

    return assistant_id.strip()


def _verify_assistant_exists(client: BackboardClient, assistant_id: str) -> None:
    """Confirm the stored assistant id can be reused before returning it."""
    try:
        client.get_assistant(assistant_id)
    except BackboardError as exc:
        raise AssistantCreationError(
            "The assistant saved in reliefLink.json could not be retrieved from Backboard. "
            "Check the API key and assistant_id before creating a replacement."
        ) from exc


def _create_and_store_assistant(client: BackboardClient) -> AssistantLoadResult:
    """Create the ReliefLink assistant and persist its id locally."""
    try:
        assistant = client.create_assistant(
            name=ASSISTANT_NAME,
            description="Humanitarian disaster-relief reporting assistant for ReliefLink AI.",
            system_prompt=ASSISTANT_SYSTEM_PROMPT,
        )
    except BackboardError as exc:
        raise AssistantCreationError("Failed to create the ReliefLink assistant on Backboard.") from exc

    assistant_id = str(assistant.assistant_id)
    _save_assistant_id(assistant_id)
    return AssistantLoadResult(assistant_id=assistant_id, was_created=True)


def _save_assistant_id(assistant_id: str) -> None:
    """Persist the assistant id so future runs reuse the same assistant."""
    payload = {
        "assistant_id": assistant_id,
        "assistant_name": ASSISTANT_NAME,
    }
    ASSISTANT_STORE_PATH.write_text(json.dumps(payload, indent=2), encoding="utf-8")


def _extract_assistant_reply(response: Any) -> str:
    """Extract the assistant text from a Backboard SDK message response."""
    content = getattr(response, "content", None)
    if isinstance(content, str) and content.strip():
        return content.strip()

    messages = getattr(response, "messages", None)
    if isinstance(messages, list):
        for item in reversed(messages):
            role = item.get("role") if isinstance(item, dict) else getattr(item, "role", None)
            text = item.get("content") if isinstance(item, dict) else getattr(item, "content", None)
            if role == "assistant" and isinstance(text, str) and text.strip():
                return text.strip()

    return ""
